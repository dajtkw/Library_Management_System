                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"bookId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/borrow",
              "host": ["{{baseUrl}}"],
              "path": ["borrow"]
            },
            "description": "Borrow a book for a user"
          },
          "response": []
